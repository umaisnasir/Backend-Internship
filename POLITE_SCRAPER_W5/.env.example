# Replace the email before running. This is identification, not a secret.
SCRAPER_USER_AGENT="YourNamePoliteScraper/1.0 (educational project; contact: your-real-email@example.com)"

SCRAPER_BASE_URL=https://books.toscrape.com/
SCRAPER_START_PATH=catalogue/page-1.html

SCRAPER_MIN_DELAY_SECONDS=1.5
SCRAPER_TIMEOUT_SECONDS=15
SCRAPER_MAX_RETRIES=3
SCRAPER_BACKOFF_BASE_SECONDS=1
SCRAPER_DEFAULT_MAX_BOOKS=30
SCRAPER_MAX_CONSECUTIVE_FAILURES=5

SCRAPER_DATABASE_PATH=data/books.db
SCRAPER_STRUCTURED_JSONL_PATH=data/processed/books.jsonl
SCRAPER_RAG_JSONL_PATH=data/processed/rag_corpus.jsonl
SCRAPER_CSV_PATH=data/processed/books.csv

SCRAPER_LOG_LEVEL=INFO
SCRAPER_LOG_PATH=logs/scraper.log